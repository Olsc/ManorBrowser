<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ManorBrowser" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/background_main</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/ManorWindowAnimation</item>
        <item name="alertDialogTheme">@style/CustomAlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/BottomSheetDialogStyle</item>
        <!-- 统一卡片/浮层圆角与阴影 -->
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Card</item>
    </style>

    <style name="ShapeAppearance.Card" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="BottomSheetDialogStyle" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/PasswordBottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="PasswordBottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearanceOverlay">@style/BottomSheetCorners</item>
    </style>

    <style name="BottomSheetCorners">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="CustomAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/DialogCorners</item>
        <item name="materialAlertDialogTitleTextStyle">@style/DialogTitleText</item>
        <item name="materialAlertDialogBodyTextStyle">@style/DialogBodyText</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogPositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogNegativeButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogNeutralButton</item>
    </style>

    <style name="DialogCorners">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="DialogTitleText" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="DialogBodyText" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="DialogPositiveButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/purple_500</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DialogNegativeButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="DialogNeutralButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Activity / 窗口转场：淡入淡出 + 轻微位移，强 ease-out -->
    <style name="ManorWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/activity_fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/window_fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/window_fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_fade_out</item>
        <item name="android:taskOpenEnterAnimation">@anim/activity_fade_in</item>
        <item name="android:taskOpenExitAnimation">@anim/window_fade_out</item>
        <item name="android:taskCloseEnterAnimation">@anim/window_fade_in</item>
        <item name="android:taskCloseExitAnimation">@anim/activity_fade_out</item>
        <item name="android:taskToBackEnterAnimation">@anim/window_fade_in</item>
        <item name="android:taskToBackExitAnimation">@anim/activity_fade_out</item>
        <item name="android:taskToFrontEnterAnimation">@anim/activity_fade_in</item>
        <item name="android:taskToFrontExitAnimation">@anim/window_fade_out</item>
    </style>
</resources>
