<?xml version="1.0" encoding="utf-8"?>
<!-- Activity 进入：轻微上移 + 淡入，强 ease-out -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/ease_out_strong">
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="220" />
    <translate
        android:fromYDelta="2.5%"
        android:toYDelta="0"
        android:duration="220" />
</set>
